{
  "name": "Bill",
  "type": "object",
  "properties": {
    "bill_number": {
      "type": "string",
      "description": "Bill number e.g. SVK-2605-0001"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "gst": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "gst_total": {
      "type": "number"
    },
    "discount": {
      "type": "number"
    },
    "grand_total": {
      "type": "number"
    },
    "payment_mode": {
      "type": "string",
      "enum": [
        "Cash",
        "UPI",
        "Credit"
      ]
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    }
  },
  "required": [
    "bill_number",
    "grand_total",
    "payment_mode"
  ]
}